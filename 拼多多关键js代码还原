traverse(ast, {
        CallExpression: {
            exit: function (path) {

                if (path.get('callee.object').node && path.get('callee.property').node.type === "StringLiteral" &&
                    ["r", "n"].includes(  path.get('callee.object').node.name)){
                    // console.log(path.toString())
                    string_value = path.get('callee.property').node.value
                    // console.log(string_value)
                    string_arguments = path.node.arguments
                    const e = path.scope.getBinding(path.get('callee.object').node.name).path.get('init').node.name

                    if (e !== undefined){

                        eScope = path.scope.getBinding(e).scope.path
                        // 遍历作用域
                        eScope.traverse({
                            AssignmentExpression: function (assignPath) {

                                if (assignPath.get("left.property").node && assignPath.get("left.property").node.value === string_value ){
                                    // 还原表达式类型
                                    // console.log(assignPath.toString())
                                    if (assignPath.get("right.body.body.0.argument").node.type === "BinaryExpression"){
                                        // console.log(assignPath.get("right.body.body.0.argument").node.type)
                                        left = string_arguments[0]
                                        right = string_arguments[1]
                                        operator = assignPath.get("right.body.body.0.argument").node.operator
                                        path.replaceInline(types.binaryExpression(operator, left, right))
                                        // console.log(left, right, operator)

                                    }
                                    // 还原函数类型
                                    else if (assignPath.get("right.body.body.0.argument").node.type === "CallExpression"){
